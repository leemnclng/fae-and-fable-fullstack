PORT=4000
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
DATA_DIR=data

# Postgres. Local: the Supabase stack (`supabase status`), e.g. postgresql://postgres:<password>@127.0.0.1:54322/postgres
# Production: the project's pooled connection string (Project Settings > Database > Connection pooling).
DATABASE_URL=
# Postgres schema holding Fae&Fable's tables; every query names it explicitly.
DB_SCHEMA=fae_fable
