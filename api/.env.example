PORT=4000
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Postgres. Local: the Supabase stack (`supabase status`), e.g. postgresql://postgres:<password>@127.0.0.1:54322/postgres
# Production: the project's pooled connection string (Project Settings > Database > Connection pooling).
DATABASE_URL=
# Postgres schema holding Fae&Fable's tables; every query names it explicitly.
DB_SCHEMA=fae_fable

# File storage: supabase (default) or s3. Credentials stay server-side; never expose them to the web app.
STORAGE_DRIVER=supabase
# Supabase: local values come from `supabase status -o env` (API_URL, SERVICE_ROLE_KEY).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=fae-fable-public
SUPABASE_PRIVATE_BUCKET=fae-fable-private
# S3-compatible (AWS S3, Cloudflare R2, MinIO), used when STORAGE_DRIVER=s3. Buckets must already exist;
# the public one must allow public reads, or set S3_PUBLIC_URL to the domain that serves it.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_URL=
